            <Component class="javax.swing.JLabel" name="lblEnunciado">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;body style='width:820px'&gt;Se crean productos con los &lt;b&gt;constructores sobrecargados&lt;/b&gt; (8 y 9 par&#xe1;metros) y se intenta insertar uno con un &lt;b&gt;SKU repetido&lt;/b&gt;: &lt;b&gt;equals()&lt;/b&gt; compara por SKU y lo rechaza. Desde el formulario se agregan productos nuevos. Con el &lt;b&gt;men&#xfa; de opciones (switch-case)&lt;/b&gt; se ordena el inventario por ID con el &lt;b&gt;sort nativo&lt;/b&gt;, por stock con el algoritmo &lt;b&gt;Burbuja&lt;/b&gt; (mayor a menor y menor a mayor) y se genera el reporte con &lt;b&gt;toString()&lt;/b&gt;.&lt;/body&gt;&lt;/html&gt;"/>
                <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                  <Border info="org.netbeans.modules.form.compat2.border.TitledBorderInfo">
                    <TitledBorder title="Enunciado"/>
                  </Border>
                </Property>
              </Properties>
              <Constraints>
                <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout" value="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout$BorderConstraintsDescription">
                  <BorderConstraints direction="Center"/>
                </Constraint>
              </Constraints>
            </Component>
          </SubComponents>
