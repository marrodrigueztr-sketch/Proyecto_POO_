            <Component class="javax.swing.JLabel" name="lblEnunciado">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;body style='width:820px'&gt;Se crean pa&#xed;ses (con el constructor con par&#xe1;metros y con el &lt;b&gt;constructor vac&#xed;o + setters&lt;/b&gt;), ciudades y gerentes. Cada &lt;b&gt;Almac&#xe9;n contiene una Ciudad y un Gerente&lt;/b&gt; (relaciones entre clases). Se registran y modifican almacenes eligiendo su ciudad y gerente. Se demuestra la &lt;b&gt;sobrecarga del m&#xe9;todo delete&lt;/b&gt;: eliminar &quot;como Operario&quot; es rechazado y &quot;como Administrador&quot; es permitido (&lt;b&gt;polimorfismo&lt;/b&gt;). Los almacenes se ordenan por ID con el &lt;b&gt;sort nativo&lt;/b&gt; y por nombre con &lt;b&gt;Burbuja&lt;/b&gt; (A-Z y Z-A).&lt;/body&gt;&lt;/html&gt;"/>
                <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                  <Border info="org.netbeans.modules.form.compat2.border.TitledBorderInfo">
                    <TitledBorder title="Enunciado"/>
                  </Border>
                </Property>
              </Properties>
              <Constraints>
                <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout" value="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout$BorderConstraintsDescription">
                  <BorderConstraints direction="Center"/>
                </Constraint>
              </Constraints>
            </Component>
          </SubComponents>
        </Container>
