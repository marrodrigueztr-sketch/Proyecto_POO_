            <Component class="javax.swing.JLabel" name="lblEnunciado">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;body style='width:820px'&gt;Se crean 4 usuarios con los &lt;b&gt;constructores sobrecargados&lt;/b&gt; de las clases hijas (Administrador, Gerente y dos Operarios: uno con contrase&#xf1;a y otro sin ella) y se insertan en el controlador. Se intenta insertar un usuario con un correo repetido (&lt;b&gt;equals&lt;/b&gt; lo impide). El usuario digita el ID del usuario a modificar (111, 222, 555 o 999), se busca con &lt;b&gt;b&#xfa;squeda binaria&lt;/b&gt;, se cambian sus datos con los &lt;b&gt;setters&lt;/b&gt; y se muestra la lista &lt;b&gt;ANTES y DESPU&#xc9;S&lt;/b&gt; de modificar con &lt;b&gt;toString()&lt;/b&gt;.&lt;/body&gt;&lt;/html&gt;"/>
                <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                  <Border info="org.netbeans.modules.form.compat2.border.TitledBorderInfo">
                    <TitledBorder title="Enunciado"/>
                  </Border>
                </Property>
              </Properties>
              <Constraints>
                <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout" value="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout$BorderConstraintsDescription">
                  <BorderConstraints direction="Center"/>
                </Constraint>
              </Constraints>
            </Component>
          </SubComponents>
